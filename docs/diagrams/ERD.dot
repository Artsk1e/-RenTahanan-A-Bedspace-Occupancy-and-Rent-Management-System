digraph ERD {
    rankdir=TB;
    node [shape=record, fontname="Arial", fontsize=9];
    edge [fontname="Arial", fontsize=8];

    USERS [label="{USERS|user_id : integer (PK)\\lusername : varchar (UK)\\lpassword_hash : varchar\\lrole : user_role\\lcreated_at : timestamp\\lupdated_at : timestamp}"];
    ROOMS [label="{ROOMS|room_id : integer (PK)\\lroom_number : varchar (UK)\\ltype : room_type\\lcapacity : integer\\lfloor_level : integer\\lcreated_at : timestamp\\lupdated_at : timestamp}"];
    BEDS [label="{BEDS|bed_id : integer (PK)\\lroom_id : integer (FK)\\lbed_code : varchar (UK)\\lstatus : bed_status\\lcreated_at : timestamp\\lupdated_at : timestamp}"];
    TENANTS [label="{TENANTS|tenant_id : integer (PK)\\luser_id : integer (FK, UK)\\lfirst_name : varchar\\llast_name : varchar\\lcontact_number : varchar\\lemergency_contact : varchar\\lstatus : tenant_status\\lcreated_at : timestamp\\lupdated_at : timestamp}"];
    CONTRACTS [label="{CONTRACTS|contract_id : integer (PK)\\ltenant_id : integer (FK)\\lbed_id : integer (FK)\\lcreated_by_user_id : integer (FK)\\lstart_date : date\\lend_date : date\\lmonthly_rate : numeric\\ladvance_rent_paid : numeric\\ldeposit_paid : numeric\\lstatus : contract_status\\lcreated_at : timestamp\\lupdated_at : timestamp}"];
    BILLING_STATEMENTS [label="{BILLING_STATEMENTS|billing_statement_id : integer (PK)\\lcontract_id : integer (FK)\\ltenant_id : integer (FK)\\lbilling_date : date\\ldue_date : date\\lamount_due : numeric\\lstatus : billing_status\\loverdue_warning_count : integer\\leviction_eligible_date : date\\lcreated_at : timestamp\\lupdated_at : timestamp}"];
    PAYMENTS [label="{PAYMENTS|payment_id : integer (PK)\\lbilling_statement_id : integer (FK)\\ltenant_id : integer (FK)\\llogged_by_user_id : integer (FK)\\lamount_paid : numeric\\lor_number : varchar (UK)\\lpayment_date : timestamp\\lremarks : text\\lupdated_at : timestamp}"];

    // Relationships with cardinality
    USERS -> TENANTS [label="1:1 optional\nON DELETE SET NULL", dir=both, arrowtail=dot];
    USERS -> CONTRACTS [label="1:N\nON DELETE SET NULL"];
    USERS -> PAYMENTS [label="1:N\nON DELETE SET NULL"];

    ROOMS -> BEDS [label="1:N\nON DELETE CASCADE", dir=both, arrowtail=crow];
    BEDS -> CONTRACTS [label="1:N\nON DELETE RESTRICT", dir=both, arrowtail=crow];

    TENANTS -> CONTRACTS [label="1:N\nON DELETE RESTRICT", dir=both, arrowtail=crow];
    TENANTS -> BILLING_STATEMENTS [label="1:N\nON DELETE CASCADE", dir=both, arrowtail=crow];
    TENANTS -> PAYMENTS [label="1:N\nON DELETE CASCADE", dir=both, arrowtail=crow];

    CONTRACTS -> BILLING_STATEMENTS [label="1:N\nON DELETE CASCADE", dir=both, arrowtail=crow];
    CONTRACTS -> PAYMENTS [label="1:N\nON DELETE SET NULL", dir=both, arrowtail=crow];

    // Layout
    {rank=same; USERS; ROOMS}
    {rank=same; BEDS; TENANTS}
    {rank=same; CONTRACTS; BILLING_STATEMENTS}
    {rank=same; PAYMENTS}
}